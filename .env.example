# Configuration reference only. The Go process reads environment variables;
# this file does not contain session secrets and is not loaded automatically.
# From server/: export variables before starting Go; no dotenv loader is used.

# Local relay bind address. Keep loopback for plain HTTP development.
ADDR=127.0.0.1:8080

# Comma-separated exact browser origins. Do not use a wildcard.
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:8080

# Relative to the Go process working directory; production image overrides it.
WEB_DIST_DIR=../web/dist

# Total TTL starts at creation; waiting timeout requires both participants.
ROOM_TTL=30m
WAITING_TTL=10m
AUTH_TIMEOUT=5s
WRITE_TIMEOUT=5s
HEARTBEAT_INTERVAL=15s
HEARTBEAT_TIMEOUT=5s

# In-memory bounds. Reverse-proxy connections share an address rate bucket;
# forwarded address headers are deliberately not trusted.
MAX_ROOMS=1000
MAX_CONNECTIONS=2100
CREATE_RATE_PER_MINUTE=30
UPGRADE_RATE_PER_MINUTE=120
MESSAGE_RATE_PER_SECOND=20

# Never put roomSecret, tokens, invitation links or chat text in this file.
